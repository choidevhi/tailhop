<?xml version="1.0" encoding="utf-8"?>
<!-- shadcn Button default: primary 면, rounded-md 6dp. 쓸 수 없으면 흐림 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33888888">
    <item>
        <selector>
            <item android:state_enabled="false"><shape android:shape="rectangle"><solid android:color="@color/sendDisabled" /><corners android:radius="6dp" /></shape></item>
            <item><shape android:shape="rectangle"><solid android:color="@color/accent" /><corners android:radius="6dp" /></shape></item>
        </selector>
    </item>
</ripple>
