<?xml version="1.0" encoding="utf-8"?>
<!-- 입력창: 덜 비치는 유리(글을 쓰는 곳이라 뒤가 덜 비치게), rounded-xl 12dp -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle"><solid android:color="@color/glassShadow" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle"><solid android:color="@color/glassShadow" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glassStrong" />
            <stroke android:width="1dp" android:color="@color/glassBorder" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
