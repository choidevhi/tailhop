<?xml version="1.0" encoding="utf-8"?>
<!-- shadcn RadioGroup 항목: 18dp 원 테두리, 고르면 안에 8dp 점 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="18dp" android:height="18dp" android:gravity="center">
                <shape android:shape="oval"><solid android:color="@android:color/transparent" /><stroke android:width="1.5dp" android:color="@color/accent" /></shape>
            </item>
            <item android:width="8dp" android:height="8dp" android:gravity="center">
                <shape android:shape="oval"><solid android:color="@color/accent" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="18dp" android:height="18dp" android:gravity="center">
                <shape android:shape="oval"><solid android:color="@android:color/transparent" /><stroke android:width="1.5dp" android:color="@color/accent" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
