<?xml version="1.0" encoding="utf-8"?>
<!-- 대화 상자 창 배경: 덜 비치는 유리(뒤 흐림이 없는 기기에서도 글이 읽히게), rounded-xl.
     API 31+는 창 뒤를 실제로 흐린다(values-v31/themes.xml). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetLeft="16dp" android:insetRight="16dp" android:insetTop="16dp" android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/glassStrong" />
        <stroke android:width="1dp" android:color="@color/glassBorder" />
        <corners android:radius="12dp" />
    </shape>
</inset>
