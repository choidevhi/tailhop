<?xml version="1.0" encoding="utf-8"?>
<!-- 팝업 메뉴 배경: 불투명한 면(팝업 창은 뒤를 흐릴 수 없다), rounded-lg 8dp. 화면 끝에 붙지 않게 오른쪽·위에 여백 -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetRight="12dp" android:insetTop="4dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/popup" />
        <stroke android:width="1dp" android:color="@color/separator" />
        <corners android:radius="8dp" />
        <padding android:top="4dp" android:bottom="4dp" />
    </shape>
</inset>
