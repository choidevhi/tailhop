<?xml version="1.0" encoding="utf-8"?>
<!-- 종류 고르기 칩(shadcn Toggle 모양): 고르면 primary 면, 아니면 유리 알약 + 테두리 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/pressed">
    <item>
        <selector>
            <item android:state_selected="true"><shape android:shape="rectangle"><solid android:color="@color/accent" /><corners android:radius="999dp" /></shape></item>
            <item><shape android:shape="rectangle"><solid android:color="@color/glass" /><stroke android:width="1dp" android:color="@color/glassBorder" /><corners android:radius="999dp" /></shape></item>
        </selector>
    </item>
</ripple>
