<?xml version="1.0" encoding="utf-8"?>
<!-- 클라우드(1.8.0, 1.9.0 유리 디자인): PC 고르기 → 폴더 보기. 떠 있는 유리 위 막대, 경로 알약, 목록 유리 카드. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <com.choidev.tailhop.GlassCard android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="8dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="6dp">
        <ImageButton android:id="@+id/backBtn" style="@style/IconBtn" android:src="@drawable/ic_back"
            android:contentDescription="@string/chat_back" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="6dp">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/label"
                android:maxLines="1" android:ellipsize="end" android:accessibilityHeading="true" />
            <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/secondary" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageButton android:id="@+id/newFolderBtn" style="@style/IconBtn" android:src="@drawable/ic_folder_plus"
            android:contentDescription="@string/cloud_new_folder" />
        <ImageButton android:id="@+id/uploadBtn" style="@style/IconBtn" android:src="@drawable/ic_cloud_upload"
            android:contentDescription="@string/cloud_upload" />
        <ImageButton android:id="@+id/refreshBtn" style="@style/IconBtn" android:src="@drawable/ic_refresh"
            android:padding="11dp" android:contentDescription="@string/cloud_refresh" />
    </com.choidev.tailhop.GlassCard>

    <!-- 지금 폴더까지의 경로(유리 알약). 조각을 누르면 그 폴더로 간다. 구분은 벡터 아이콘(ic_chevron_right) -->
    <HorizontalScrollView android:id="@+id/crumbsScroll" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass" android:scrollbars="none" android:fillViewport="false">
        <LinearLayout android:id="@+id/crumbs" android:layout_width="wrap_content" android:layout_height="40dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="10dp" />
    </HorizontalScrollView>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp">
        <com.choidev.tailhop.GlassCard android:id="@+id/listCard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="top" android:orientation="vertical"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="12dp">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/list"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false"
                android:paddingTop="4dp" android:paddingBottom="4dp" />
        </com.choidev.tailhop.GlassCard>
        <com.choidev.tailhop.GlassCard android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
            android:layout_marginBottom="48dp" android:orientation="vertical" android:gravity="center_horizontal"
            android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="28dp" android:paddingBottom="24dp"
            android:visibility="gone">
            <ImageView android:id="@+id/emptyIcon" android:layout_width="56dp" android:layout_height="56dp"
                android:padding="15dp" android:background="@drawable/bg_icon_tile" android:src="@drawable/ic_cloud"
                android:tint="@color/label" android:importantForAccessibility="no" />
            <TextView android:id="@+id/emptyTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:textSize="20sp" android:textStyle="bold" android:letterSpacing="-0.01"
                android:textColor="@color/label" android:gravity="center" />
            <TextView android:id="@+id/emptySub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/secondary" android:gravity="center" />
            <Button android:id="@+id/emptyBtn" style="@style/Btn.Tinted" android:layout_width="wrap_content"
                android:layout_weight="0" android:layout_marginTop="20dp" android:text="@string/cloud_retry" android:visibility="gone" />
        </com.choidev.tailhop.GlassCard>
    </FrameLayout>
</LinearLayout>
