<?xml version="1.0" encoding="utf-8"?>
<!-- 클라우드(1.8.0, 1.9.0 유리 디자인): PC 고르기 → 폴더 보기. 떠 있는 유리 위 막대, 경로 알약, 목록 유리 카드. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <!-- 위 막대. 다중 선택(2.1.0) 중에는 같은 자리에 선택 막대(n개 선택·닫기·모두 선택)가 대신 보인다 -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="8dp">
    <com.choidev.tailhop.GlassCard android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="6dp">
        <ImageButton android:id="@+id/backBtn" style="@style/IconBtn" android:src="@drawable/ic_back"
            android:contentDescription="@string/chat_back" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="6dp">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/label"
                android:maxLines="1" android:ellipsize="end" android:accessibilityHeading="true" />
            <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/secondary" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageButton android:id="@+id/newFolderBtn" style="@style/IconBtn" android:src="@drawable/ic_folder_plus"
            android:contentDescription="@string/cloud_new_folder" />
        <ImageButton android:id="@+id/uploadBtn" style="@style/IconBtn" android:src="@drawable/ic_cloud_upload"
            android:contentDescription="@string/cloud_upload" />
        <ImageButton android:id="@+id/refreshBtn" style="@style/IconBtn" android:src="@drawable/ic_refresh"
            android:padding="11dp" android:contentDescription="@string/cloud_refresh" />
    </com.choidev.tailhop.GlassCard>
    <com.choidev.tailhop.GlassCard android:id="@+id/selBar" android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="6dp"
        android:visibility="gone">
        <ImageButton android:id="@+id/selClose" style="@style/IconBtn" android:src="@drawable/ic_close"
            android:contentDescription="@string/select_end" />
        <TextView android:id="@+id/selCount" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="15sp"
            android:fontFamily="sans-serif-medium" android:textColor="@color/label" android:maxLines="1"
            android:ellipsize="end" android:accessibilityLiveRegion="polite" />
        <ImageButton android:id="@+id/selAll" style="@style/IconBtn" android:src="@drawable/ic_check_all"
            android:contentDescription="@string/select_all" />
    </com.choidev.tailhop.GlassCard>
    </FrameLayout>

    <!-- 찾기(2.0.0, §15 cloud_search): 허브가 "cloud2"를 알릴 때만 보인다. 이 폴더 아래까지 이름으로 찾는다 -->
    <com.choidev.tailhop.GlassCard android:id="@+id/searchBar" android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="8dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="4dp"
        android:visibility="gone">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_search"
            android:tint="@color/secondary" android:importantForAccessibility="no" />
        <EditText android:id="@+id/searchBox" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginStart="8dp" android:background="@null" android:hint="@string/cloud_search_hint"
            android:textSize="15sp" android:textColor="@color/label" android:inputType="text" android:imeOptions="actionSearch"
            android:maxLength="100" android:singleLine="true" android:importantForAutofill="no" />
        <ImageButton android:id="@+id/searchClear" style="@style/IconBtn" android:layout_width="36dp" android:layout_height="36dp"
            android:padding="9dp" android:src="@drawable/ic_close" android:visibility="gone"
            android:contentDescription="@string/search_clear" />
    </com.choidev.tailhop.GlassCard>

    <!-- 종류 고르기(전체·사진·영상·음악·문서·압축·기타). 칩은 코드가 만든다 -->
    <HorizontalScrollView android:id="@+id/kindScroll" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:scrollbars="none" android:clipToPadding="false" android:visibility="gone">
        <LinearLayout android:id="@+id/kindChips" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp" />
    </HorizontalScrollView>

    <!-- 지금 폴더까지의 경로(유리 알약)와 격자/목록 바꾸기. 조각을 누르면 그 폴더로 간다. 구분은 벡터 아이콘(ic_chevron_right) -->
    <com.choidev.tailhop.GlassCard android:id="@+id/crumbsRow" android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="8dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="0dp" android:paddingEnd="2dp">
        <HorizontalScrollView android:id="@+id/crumbsScroll" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:scrollbars="none" android:fillViewport="false">
            <LinearLayout android:id="@+id/crumbs" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="10dp" />
        </HorizontalScrollView>
        <ImageButton android:id="@+id/viewBtn" style="@style/IconBtn" android:padding="10dp" android:src="@drawable/ic_grid"
            android:visibility="gone" android:contentDescription="@string/cloud_view_grid" />
    </com.choidev.tailhop.GlassCard>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp">
        <com.choidev.tailhop.GlassCard android:id="@+id/listCard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="top" android:orientation="vertical"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="12dp">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/list"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false"
                android:paddingTop="4dp" android:paddingBottom="4dp" />
        </com.choidev.tailhop.GlassCard>
        <com.choidev.tailhop.GlassCard android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
            android:layout_marginBottom="48dp" android:orientation="vertical" android:gravity="center_horizontal"
            android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="28dp" android:paddingBottom="24dp"
            android:visibility="gone">
            <ImageView android:id="@+id/emptyIcon" android:layout_width="56dp" android:layout_height="56dp"
                android:padding="15dp" android:background="@drawable/bg_icon_tile" android:src="@drawable/ic_cloud"
                android:tint="@color/label" android:importantForAccessibility="no" />
            <TextView android:id="@+id/emptyTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:textSize="20sp" android:textStyle="bold" android:letterSpacing="-0.01"
                android:textColor="@color/label" android:gravity="center" />
            <TextView android:id="@+id/emptySub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/secondary" android:gravity="center" />
            <Button android:id="@+id/emptyBtn" style="@style/Btn.Tinted" android:layout_width="wrap_content"
                android:layout_weight="0" android:layout_marginTop="20dp" android:text="@string/cloud_retry" android:visibility="gone" />
        </com.choidev.tailhop.GlassCard>
    </FrameLayout>

    <!-- 다중 선택(2.1.0)의 동작 막대(유리): 옮기기(허브가 "move"를 알릴 때만)·이름 바꾸기(2.2.1, "rename"일 때만)·받기·지우기·
         더보기(하나만 골랐을 때) -->
    <com.choidev.tailhop.GlassCard android:id="@+id/actionBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="12dp"
        android:orientation="horizontal" android:padding="4dp" android:visibility="gone">
        <LinearLayout android:id="@+id/actMove" style="@style/ActBtn">
            <ImageView style="@style/ActIcon" android:src="@drawable/ic_folder_input" />
            <TextView style="@style/ActLabel" android:text="@string/cloud_move" />
        </LinearLayout>
        <LinearLayout android:id="@+id/actRename" style="@style/ActBtn">
            <ImageView style="@style/ActIcon" android:src="@drawable/ic_pencil" />
            <TextView style="@style/ActLabel" android:text="@string/rename_action" />
        </LinearLayout>
        <LinearLayout android:id="@+id/actDownload" style="@style/ActBtn">
            <ImageView style="@style/ActIcon" android:src="@drawable/ic_download" />
            <TextView style="@style/ActLabel" android:text="@string/cloud_download" />
        </LinearLayout>
        <LinearLayout android:id="@+id/actDelete" style="@style/ActBtn">
            <ImageView style="@style/ActIcon" android:src="@drawable/ic_trash" />
            <TextView style="@style/ActLabel" android:text="@string/cloud_delete" />
        </LinearLayout>
        <LinearLayout android:id="@+id/actMore" style="@style/ActBtn">
            <ImageView style="@style/ActIcon" android:src="@drawable/ic_more" />
            <TextView style="@style/ActLabel" android:text="@string/cloud_more" />
        </LinearLayout>
    </com.choidev.tailhop.GlassCard>
</LinearLayout>
