<?xml version="1.0" encoding="utf-8"?>
<!-- 홈의 기기 한 줄(유리 카드 안): 아이콘 칸(rounded-lg) + 상태 점, 이름·시각, 마지막 내용 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="68dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="16dp"
    android:baselineAligned="false"
    android:background="@drawable/bg_row_press" android:clickable="true" android:focusable="true">
    <FrameLayout android:layout_width="42dp" android:layout_height="42dp">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="10dp"
            android:background="@drawable/bg_icon_tile" android:src="@drawable/ic_laptop" android:tint="@color/label"
            android:importantForAccessibility="no" />
        <ImageView android:id="@+id/dot" android:layout_width="10dp" android:layout_height="10dp"
            android:layout_gravity="bottom|end" android:src="@drawable/dot_green" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/label"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="12sp" android:textColor="@color/secondary" />
        </LinearLayout>
        <TextView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="13sp" android:textColor="@color/secondary"
            android:maxLines="1" android:ellipsize="end" android:drawablePadding="4dp" />
    </LinearLayout>
</LinearLayout>
