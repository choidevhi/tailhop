<?xml version="1.0" encoding="utf-8"?>
<!-- 대화 한 줄(1.9.0 유리 디자인): 날짜는 유리 알약, 말풍선은 내 것 primary·받은 것 유리(ChatActivity.outStyle),
     이름·시각은 배경 위에 바로 놓이므로 진한 회색(secondaryOnBackdrop) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="2dp">
    <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginTop="14dp" android:layout_marginBottom="10dp"
        android:background="@drawable/bg_chip" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="3dp" android:paddingBottom="3dp"
        android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="@color/secondary" />
    <TextView android:id="@+id/who" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:layout_marginBottom="3dp" android:paddingStart="4dp" android:textSize="12sp"
        android:fontFamily="sans-serif-medium" android:textColor="@color/secondaryOnBackdrop" />
    <LinearLayout android:id="@+id/bubble" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="9dp" android:paddingBottom="9dp">
        <ImageView android:id="@+id/fileIcon" android:layout_width="38dp" android:layout_height="38dp"
            android:padding="9dp" android:layout_marginEnd="10dp" android:src="@drawable/ic_doc"
            android:background="@drawable/bg_icon_tile" android:tint="@color/label"
            android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/body" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:lineSpacingExtra="3dp" android:textColor="@color/label" />
            <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:layout_marginTop="1dp" android:textColor="@color/secondary" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:layout_marginBottom="8dp" android:paddingStart="4dp" android:paddingEnd="4dp"
        android:textSize="11sp" android:textColor="@color/secondaryOnBackdrop" />
</LinearLayout>
