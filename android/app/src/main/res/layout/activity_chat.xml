<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="8dp">
        <ImageButton android:id="@+id/backBtn" android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_row_press" android:src="@drawable/ic_back" android:tint="@color/label"
            android:contentDescription="@string/chat_back" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="4dp">
            <TextView android:id="@+id/pcName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="16sp" android:textStyle="bold" android:textColor="@color/label"
                android:maxLines="1" android:ellipsize="end" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/dot" android:layout_width="7dp" android:layout_height="7dp"
                    android:layout_marginEnd="5dp" android:src="@drawable/dot_green" android:importantForAccessibility="no" />
                <TextView android:id="@+id/pairState" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/secondary" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <ImageButton android:id="@+id/moreBtn" android:layout_width="44dp" android:layout_height="44dp"
            android:background="@drawable/bg_row_press" android:src="@drawable/ic_more" android:tint="@color/label"
            android:contentDescription="@string/more" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/chat"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingTop="4dp" android:paddingBottom="8dp" />
        <LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:padding="32dp" android:visibility="gone">
            <ImageView android:layout_width="64dp" android:layout_height="64dp"
                android:padding="18dp" android:background="@drawable/circle_outline_lg" android:src="@drawable/ic_bubble"
                android:tint="@color/label" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:textSize="26sp" android:textStyle="bold"
                android:textColor="@color/label" android:text="@string/chat_empty_title" android:gravity="center" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textSize="15sp" android:textColor="@color/secondary"
                android:text="@string/chat_empty_sub" android:gravity="center" />
        </LinearLayout>
    </FrameLayout>

    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" android:indeterminate="true"
        android:indeterminateTint="@color/label" android:visibility="invisible" />
    <TextView android:id="@+id/progressText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textSize="12sp" android:textColor="@color/secondary" android:visibility="gone" />

    <LinearLayout android:id="@+id/composer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp" android:background="@drawable/bg_composer" android:elevation="3dp"
        android:orientation="horizontal" android:gravity="bottom" android:padding="7dp">
        <ImageButton android:id="@+id/plusBtn" android:layout_width="38dp" android:layout_height="38dp"
            android:background="@drawable/circle_outline" android:src="@drawable/ic_plus" android:tint="@color/label"
            android:padding="8dp" android:scaleType="fitCenter" android:contentDescription="@string/chat_send_file" />
        <EditText android:id="@+id/textBox" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="38dp" android:background="@null"
            android:paddingStart="12dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp"
            android:hint="@string/chat_hint" android:maxLines="5" android:textSize="16sp" android:textColor="@color/label"
            android:inputType="textMultiLine|textCapSentences" android:importantForAutofill="no" />
        <ImageButton android:id="@+id/sendBtn" android:layout_width="38dp" android:layout_height="38dp"
            android:background="@drawable/circle_send" android:src="@drawable/ic_arrow_up" android:tint="@color/onAccent"
            android:padding="8dp" android:scaleType="fitCenter" android:contentDescription="@string/chat_send" android:enabled="false" />
    </LinearLayout>
</LinearLayout>
