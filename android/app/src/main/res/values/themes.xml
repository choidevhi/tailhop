<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 1.9.0 shadcn/ui 유리 디자인: 창 배경이 오로라(bg_backdrop), 그 위 카드·막대가 반투명 유리(bg_glass).
         대화 상자·팝업도 유리이고, API 31+는 창 뒤를 실제로 흐린다(values-v31). -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_backdrop</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlNormal">@color/secondary</item>
        <item name="android:textColorPrimary">@color/label</item>
        <item name="android:textColorSecondary">@color/secondary</item>
        <item name="android:textColorHint">@color/secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/lightBars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/lightBars</item>
        <item name="alertDialogTheme">@style/GlassDialog</item>
        <item name="android:popupMenuStyle">@style/GlassPopup</item>
        <item name="switchStyle">@style/ShadSwitch</item>
        <item name="checkboxStyle">@style/ShadCheckBox</item>
        <item name="android:checkboxStyle">@style/ShadCheckBox</item>
        <item name="radioButtonStyle">@style/ShadRadio</item>
        <item name="android:radioButtonStyle">@style/ShadRadio</item>
    </style>

    <!-- 대화 상자: 덜 비치는 유리 창(rounded-xl), 버튼은 shadcn default(확인)·ghost(취소·가운데). 흐림은 values-v31 -->
    <style name="GlassDialog.Base" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_glass</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/label</item>
        <item name="android:textColorSecondary">@color/secondary</item>
        <item name="android:backgroundDimAmount">0.3</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogBtn.Default</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogBtn.Ghost</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogBtn.Ghost</item>
        <item name="android:listChoiceIndicatorSingle">@drawable/radio_dot</item>
        <item name="android:listChoiceIndicatorMultiple">@drawable/checkbox_box</item>
        <item name="checkboxStyle">@style/ShadCheckBox</item>
        <item name="android:checkboxStyle">@style/ShadCheckBox</item>
        <item name="radioButtonStyle">@style/ShadRadio</item>
        <item name="android:radioButtonStyle">@style/ShadRadio</item>
    </style>
    <style name="GlassDialog" parent="GlassDialog.Base" />

    <style name="DialogBtn" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="DialogBtn.Default">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/onAccent</item>
    </style>
    <style name="DialogBtn.Ghost">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/label</item>
    </style>

    <!-- 팝업 메뉴(더보기): 덜 비치는 유리 -->
    <style name="GlassPopup" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_glass</item>
        <item name="android:popupElevation">6dp</item>
    </style>

    <!-- shadcn Switch·Checkbox·RadioGroup 모양(벡터·모양 drawable, 색칠은 drawable이 한다) -->
    <style name="ShadSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="track">@drawable/switch_track</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
        <item name="switchMinWidth">44dp</item>
        <item name="switchPadding">0dp</item>
    </style>
    <style name="ShadCheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:button">@drawable/checkbox_box</item>
        <item name="buttonCompat">@drawable/checkbox_box</item>
        <item name="android:buttonTint">@null</item>
        <item name="buttonTint">@null</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:minHeight">40dp</item>
    </style>
    <style name="ShadRadio" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@drawable/radio_dot</item>
        <item name="buttonCompat">@drawable/radio_dot</item>
        <item name="android:buttonTint">@null</item>
        <item name="buttonTint">@null</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- 공유 대상: 화면 없이 확인 창만 띄운다 -->
    <style name="ShareTheme" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="LargeTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
    </style>
    <style name="Header">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:paddingTop">26dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/header</item>
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
    </style>
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <style name="RowIcon">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:layout_marginEnd">14dp</item>
    </style>
    <style name="RowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="RowSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/secondary</item>
    </style>
    <style name="Sep">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:layout_marginStart">66dp</item>
        <item name="android:background">@color/separator</item>
    </style>
    <style name="ActionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:background">@drawable/bg_row_press</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <!-- shadcn Button: h 36dp, rounded-md 6dp, 14sp medium. default(Primary)·outline(Tinted)·ghost -->
    <style name="Btn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Btn.Primary">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/onAccent</item>
    </style>
    <style name="Btn.Tinted">
        <item name="android:background">@drawable/bg_btn_tinted</item>
        <item name="android:textColor">@color/label</item>
    </style>
    <!-- 아이콘 버튼(shadcn ghost, size icon): 40dp 칸 안 20dp 아이콘 -->
    <style name="IconBtn">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:tint">@color/label</item>
    </style>
    <!-- 유리 카드 안 줄 앞의 아이콘 칸(rounded-lg) -->
    <style name="RowTile">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">@drawable/bg_icon_tile</item>
        <item name="android:tint">@color/label</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <!-- 배경(오로라) 위에 바로 놓이는 작은 머리 글자: 유리 위보다 진한 회색(대비 4.5:1) -->
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/secondaryOnBackdrop</item>
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
    </style>
</resources>
